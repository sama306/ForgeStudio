---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { Clients } from '../components/Clients';
import { Services } from '../components/Services';
import { Process } from '../components/Process';
import { Projects } from '../components/Projects';
import { Stats } from '../components/Stats';
import { Testimonials } from '../components/Testimonials';
import { CTA } from '../components/CTA';
---

<Layout
	title="Forge Studio — Experiencias digitales que convierten."
	description="Estudio de diseño digital que crea experiencias web premium, identidades de marca y productos de alto rendimiento."
	ogUrl="https://forgestudio.dev"
>
	<div slot="header" />
	<main slot="main">
		<Hero />
		<Clients />
		<Services />
		<Process />
		<Projects />
		<Stats />
		<Testimonials />
		<CTA />
	</main>

