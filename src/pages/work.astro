---
import Layout from '../layouts/Layout.astro';
import { ProjectCard } from '../components/ProjectCard';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout
  title="Nuestros Trabajos — Forge Studio"
  description="Explorá nuestro portafolio completo de productos digitales, identidades de marca y experiencias web — de fintech a salud y más allá."
  ogUrl="https://forgestudio.dev/work"
>
  <main slot="main">
    <section class="bg-bg px-6 py-24">
      <div class="mx-auto max-w-6xl">
        <h1 class="font-heading font-bold leading-none text-text" style="font-size: var(--text-h1)">
          Nuestros Trabajos
        </h1>
        <p class="mt-4 max-w-xl font-sans text-muted" style="font-size: var(--text-body);">
          Cada proyecto es una colaboración. Explorá nuestro portafolio de diseño, desarrollo y estrategia.
        </p>

        <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard {project} />
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
