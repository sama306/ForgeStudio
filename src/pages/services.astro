---
import Layout from '../layouts/Layout.astro';
import { services } from '../utils/services';
import { CTA } from '../components/CTA';
---

<Layout
  title="Services — Forge Studio"
  description="Full-service digital design and development: web design, UI/UX, brand identity, motion design, and strategic consulting."
  ogUrl="https://forgestudio.dev/services"
>
  <div slot="header" />

  <main slot="main">
    <section class="bg-bg px-6 pt-32 pb-8" aria-label="Services hero">
      <div class="mx-auto max-w-6xl">
        <h1 class="font-heading font-bold leading-none text-text" style="font-size: var(--text-h1)" data-reveal>
          Services
        </h1>
        <p class="mt-6 max-w-2xl font-sans leading-relaxed text-muted" style="font-size: var(--text-body);">
          Six capabilities, one unified approach. From strategy to launch, every service is designed to work independently or as part of a larger ecosystem — because great work happens at the intersection of disciplines.
        </p>
      </div>
    </section>

    <nav class="sticky top-0 z-20 border-b border-muted/10 bg-bg/90 backdrop-blur-md" aria-label="Service navigation">
      <ul class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-6 py-3 text-sm font-medium">
        {
          services.map((s, i) => (
            <li>
              <a
                href={`#${s.id}`}
                class="block whitespace-nowrap rounded-full px-4 py-1.5 font-sans text-muted transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span class="mr-1.5 text-xs text-accent" aria-hidden="true">{(i + 1).toString().padStart(2, '0')}</span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="bg-bg">
      {
        services.map((service, i) => {
          const pad = (i + 1).toString().padStart(2, '0');
          return (
            <section
              id={service.id}
              class="border-b border-muted/10 px-6 py-24 last:border-b-0"
              aria-label={service.title}
            >
              <div class="mx-auto max-w-6xl">
                <div class="grid gap-12 lg:grid-cols-5">
                  <div class="lg:col-span-2">
                    <span class="font-display text-5xl font-bold leading-none text-accent/20 sm:text-7xl" aria-hidden="true">
                      {pad}
                    </span>
                    <h2 class="mt-4 font-heading text-3xl font-bold leading-tight text-text sm:text-4xl" data-reveal>
                      {service.title}
                    </h2>
                  </div>

                  <div class="lg:col-span-3 lg:pt-10">
                    <p class="font-sans leading-relaxed text-text">
                      {service.description}
                    </p>

                    <div class="mt-10">
                      <h3 class="font-heading text-sm font-semibold uppercase tracking-widest text-accent">
                        Qué incluye
                      </h3>
                      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                        {service.includes.map((item) => (
                          <li class="flex items-start gap-2 font-sans text-sm text-muted">
                            <span class="mt-0.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent" aria-hidden="true" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="mt-12">
                      <h3 class="font-heading text-sm font-semibold uppercase tracking-widest text-accent">
                        Proceso
                      </h3>
                      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                        {service.process.map((step, j) => (
                          <div class="relative border-l border-accent/30 pl-4">
                            <span class="font-display text-xs font-bold text-accent" aria-hidden="true">
                              {(j + 1).toString().padStart(2, '0')}
                            </span>
                            <h4 class="mt-1 font-heading text-sm font-semibold text-text">
                              {step.title}
                            </h4>
                            <p class="mt-1 font-sans text-xs leading-relaxed text-muted">
                              {step.description}
                            </p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          );
        })
      }
    </div>

    <CTA heading="Ready to bring your\nnext project to life?" label="Let's talk →" href="/contact" />
  </main>
</Layout>

<script>
import { revealHeadings } from '../utils/textReveal';
revealHeadings('[data-reveal]', { stagger: 0.05, yOffset: 24 });
</script>
