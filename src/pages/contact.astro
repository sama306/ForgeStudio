---
import Layout from '../layouts/Layout.astro';
import { CTA } from '../components/CTA';
---

<Layout
  title="Contacto — Forge Studio"
  description="Conversemos sobre tu próximo proyecto. Desde una identidad de marca hasta un producto digital completo, en Forge Studio lo hacemos realidad."
  ogUrl="https://forgestudio.dev/contact"
>
  <main slot="main">
    <!-- Hero de contacto -->
    <section
      class="relative overflow-hidden bg-bg px-6 pb-16 pt-32"
      aria-label="Contacto"
    >
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/5 blur-3xl" />
        <div class="absolute -top-40 right-0 h-[400px] w-[400px] rounded-full bg-accent/3 blur-3xl" />
      </div>

      <div class="contact-hero-content relative z-10 mx-auto max-w-4xl text-center">
        <h1
          class="contact-heading font-heading font-bold leading-none text-text"
          style="font-size: var(--text-h1)"
        >
          Experiencias digitales
          <span class="text-accent">que convierten.</span>
        </h1>
        <p
          class="contact-subtitle mx-auto mt-6 max-w-2xl font-sans leading-relaxed text-muted"
          style="font-size: var(--text-h2);"
        >
          Contanos sobre tu proyecto. Sin compromisos, sin vueltas — solo una
          conversación para descubrir si podemos crear algo increíble juntos.
        </p>
      </div>
    </section>

    <!-- Formulario -->
    <section class="bg-bg px-6 pb-32" aria-label="Formulario de contacto">
      <div class="mx-auto max-w-2xl">
        <form
          id="contact-form"
          novalidate
          class="space-y-8"
          aria-label="Formulario de contacto"
        >
          <!-- Nombre -->
          <div>
            <label
              for="contact-name"
              class="mb-2 block font-heading text-sm font-semibold text-text"
            >
              Nombre <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
              class="contact-input w-full rounded-xl border border-muted/20 bg-surface px-5 py-3.5 font-sans text-sm text-text placeholder:text-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-shadow duration-300"
            />
            <p class="contact-error mt-1.5 hidden text-xs font-sans text-red-400" id="contact-name-error" role="alert">
              El nombre es obligatorio.
            </p>
          </div>

          <!-- Email -->
          <div>
            <label
              for="contact-email"
              class="mb-2 block font-heading text-sm font-semibold text-text"
            >
              Email <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="tu@email.com"
              class="contact-input w-full rounded-xl border border-muted/20 bg-surface px-5 py-3.5 font-sans text-sm text-text placeholder:text-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-shadow duration-300"
            />
            <p class="contact-error mt-1.5 hidden text-xs font-sans text-red-400" id="contact-email-error" role="alert">
              Ingresá un email válido.
            </p>
          </div>

          <!-- Asunto / Tipo de proyecto -->
          <div>
            <label
              for="contact-subject"
              class="mb-2 block font-heading text-sm font-semibold text-text"
            >
              Tipo de proyecto <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <select
              id="contact-subject"
              name="subject"
              required
              class="contact-input w-full appearance-none rounded-xl border border-muted/20 bg-surface px-5 py-3.5 font-sans text-sm text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-shadow duration-300"
            >
              <option value="" disabled selected>Seleccioná una opción</option>
              <option value="web-design">Diseño Web</option>
              <option value="ui-ux">UI / UX Design</option>
              <option value="development">Desarrollo</option>
              <option value="brand-identity">Identidad de Marca</option>
              <option value="motion">Motion Design</option>
              <option value="strategy">Estrategia / Consultoría</option>
              <option value="other">Otro</option>
            </select>
            <p class="contact-error mt-1.5 hidden text-xs font-sans text-red-400" id="contact-subject-error" role="alert">
              Seleccioná un tipo de proyecto.
            </p>
          </div>

          <!-- Mensaje -->
          <div>
            <label
              for="contact-message"
              class="mb-2 block font-heading text-sm font-semibold text-text"
            >
              Mensaje <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="6"
              placeholder="Contanos sobre tu proyecto, tus objetivos y cómo podemos ayudarte..."
              class="contact-input w-full resize-y rounded-xl border border-muted/20 bg-surface px-5 py-3.5 font-sans text-sm text-text placeholder:text-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-shadow duration-300"
            ></textarea>
            <p class="contact-error mt-1.5 hidden text-xs font-sans text-red-400" id="contact-message-error" role="alert">
              El mensaje no puede estar vacío.
            </p>
          </div>

          <!-- Submit -->
          <div class="pt-2">
            <button
              type="submit"
              id="contact-submit"
              class="contact-submit inline-flex h-14 w-full items-center justify-center rounded-full bg-accent px-12 text-sm font-semibold tracking-wide text-bg transition-all duration-300 hover:shadow-[0_0_24px_color-mix(in_srgb,var(--color-accent)_40%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg will-change-transform"
            >
              <span class="submit-label">Enviar mensaje</span>
              <span class="submit-spinner hidden" aria-hidden="true">
                <svg class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
              </span>
            </button>
          </div>

          <!-- Feedback states -->
          <div
            id="contact-success"
            class="hidden rounded-xl border border-green-500/30 bg-green-500/10 px-6 py-5 text-center"
            role="status"
          >
            <p class="font-heading text-base font-semibold text-green-400">
              ¡Mensaje enviado con éxito!
            </p>
            <p class="mt-1 font-sans text-sm text-green-300/80">
              Gracias por escribirnos. Te responderemos a la brevedad.
            </p>
          </div>

          <div
            id="contact-error"
            class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-6 py-5 text-center"
            role="alert"
          >
            <p class="font-heading text-base font-semibold text-red-400">
              Error al enviar el mensaje.
            </p>
            <p class="mt-1 font-sans text-sm text-red-300/80">
              Hubo un problema. Por favor intentá de nuevo más tarde.
            </p>
          </div>
        </form>
      </div>
    </section>

    <!-- CTA final -->
    <CTA
      heading="¿Listo para empezar?"
      label="Agendá una llamada →"
      href="/contact"
    />
  </main>
</Layout>

<script>
import gsap from 'gsap';

interface FormElements extends HTMLFormControlsCollection {
  name: HTMLInputElement;
  email: HTMLInputElement;
  subject: HTMLSelectElement;
  message: HTMLTextAreaElement;
}

// ── Reveal de entrada ──
const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

if (!prefersReduced) {
  const heading = document.querySelector('.contact-heading');
  const subtitle = document.querySelector('.contact-subtitle');

  if (heading) {
    gsap.fromTo(heading,
      { opacity: 0, filter: 'blur(20px)', y: 24 },
      { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.8, ease: 'power3.out' }
    );
  }

  if (subtitle) {
    gsap.fromTo(subtitle,
      { opacity: 0, filter: 'blur(12px)', y: 16 },
      { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.6, ease: 'power3.out', delay: 0.25 }
    );
  }
}

const form = document.getElementById('contact-form') as HTMLFormElement | null;
if (!form) throw new Error('Form not found');

  const elements = form.elements as FormElements;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
  const submitLabel = submitBtn.querySelector('.submit-label') as HTMLSpanElement;
  const submitSpinner = submitBtn.querySelector('.submit-spinner') as HTMLSpanElement;
  const successBox = document.getElementById('contact-success') as HTMLDivElement;
  const errorBox = document.getElementById('contact-error') as HTMLDivElement;

  type FieldKey = 'name' | 'email' | 'subject' | 'message';
  const fieldKeys: FieldKey[] = ['name', 'email', 'subject', 'message'];

  function getErrorEl(key: FieldKey): HTMLParagraphElement {
    return document.getElementById(`contact-${key}-error`) as HTMLParagraphElement;
  }

  function validateField(key: FieldKey): boolean {
    const el = elements[key];
    const err = getErrorEl(key);
    let valid = true;
    let msg = '';

    if (key === 'name') {
      valid = el.value.trim().length > 0;
      msg = 'El nombre es obligatorio.';
    } else if (key === 'email') {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      valid = emailRegex.test(el.value.trim());
      msg = 'Ingresá un email válido.';
    } else if (key === 'subject') {
      valid = el.value !== '';
      msg = 'Seleccioná un tipo de proyecto.';
    } else if (key === 'message') {
      valid = el.value.trim().length > 0;
      msg = 'El mensaje no puede estar vacío.';
    }

    el.setAttribute('aria-invalid', String(!valid));
    if (!valid) {
      err.textContent = msg;
      err.classList.remove('hidden');
      el.classList.add('border-red-400');
    } else {
      err.classList.add('hidden');
      el.classList.remove('border-red-400');
    }

    return valid;
  }

  function validateAll(): boolean {
    let allValid = true;
    for (const key of fieldKeys) {
      if (!validateField(key)) allValid = false;
    }
    return allValid;
  }

  for (const key of fieldKeys) {
    elements[key].addEventListener('blur', () => validateField(key));
    elements[key].addEventListener('input', () => {
      const err = getErrorEl(key);
      if (!err.classList.contains('hidden')) validateField(key);
    });
  }

  // ── Magnetic hover (submit button) ──
  if (!prefersReduced && !('ontouchstart' in window || navigator.maxTouchPoints > 0)) {
    submitBtn.addEventListener('mousemove', (e: MouseEvent) => {
      if (submitBtn.disabled) return;
      const rect = submitBtn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      submitBtn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px) scale(1.04)`;
    });

    submitBtn.addEventListener('mouseleave', () => {
      submitBtn.style.removeProperty('transform');
    });
  }

  form.addEventListener('submit', async (e: SubmitEvent) => {
    e.preventDefault();

    if (!validateAll()) return;

    // Hide previous feedback
    successBox.classList.add('hidden');
    errorBox.classList.add('hidden');

    // Sending state
    submitBtn.disabled = true;
    submitLabel.classList.add('hidden');
    submitSpinner.classList.remove('hidden');
    submitBtn.classList.add('pointer-events-none', 'opacity-70');

    try {
      const endpoint = typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_FORMSPREE_ENDPOINT
        ? import.meta.env.PUBLIC_FORMSPREE_ENDPOINT
        : '';

      if (!endpoint) {
        throw new Error('PUBLIC_FORMSPREE_ENDPOINT no está configurado');
      }

      const formData = new FormData(form);
      const response = await fetch(endpoint, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error('Error en el envío');

      // Success
      successBox.classList.remove('hidden');
      form.reset();
      for (const key of fieldKeys) {
        elements[key].setAttribute('aria-invalid', 'false');
        elements[key].classList.remove('border-red-400');
        getErrorEl(key).classList.add('hidden');
      }
    } catch {
      // Error
      errorBox.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitLabel.classList.remove('hidden');
      submitSpinner.classList.add('hidden');
      submitBtn.classList.remove('pointer-events-none', 'opacity-70');
    }
  });
</script>

<style>
  .contact-heading,
  .contact-subtitle {
    opacity: 0;
    filter: blur(20px);
  }

  .contact-input {
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .contact-input:hover {
    border-color: var(--color-muted);
  }

  .contact-input:focus,
  .contact-input:focus-visible {
    border-color: var(--color-accent);
    box-shadow:
      0 0 0 1px var(--color-accent),
      0 0 20px color-mix(in srgb, var(--color-accent) 25%, transparent);
    outline: none;
  }

  .contact-submit {
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      opacity 0.3s ease,
      transform 0.15s ease;
    will-change: transform;
  }

  .contact-submit:hover,
  .contact-submit:focus-visible {
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .contact-submit:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-heading,
    .contact-subtitle {
      opacity: 1;
      filter: blur(0);
    }

    .contact-input,
    .contact-submit {
      transition: none;
    }

    .submit-spinner svg {
      animation: none;
    }
  }
</style>
