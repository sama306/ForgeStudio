---
const links = [
  { label: 'Trabajos', href: '/work' },
  { label: 'Servicios', href: '/services' },
  { label: 'Nosotros', href: '/about' },
  { label: 'Contacto', href: '/contact' },
];

const socials = [
  { label: 'GitHub', href: '#', icon: 'GH' },
  { label: 'Dribbble', href: '#', icon: 'DB' },
  { label: 'LinkedIn', href: '#', icon: 'LI' },
  { label: 'X / Twitter', href: '#', icon: 'X' },
];
---

<footer class="border-t border-muted/10 bg-bg px-6 py-16" aria-label="Pie de página">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col items-center justify-between gap-10 md:flex-row md:items-start">
      <div class="text-center md:text-left">
        <a href="/" class="font-heading text-xl tracking-tight text-text" aria-label="Forge Studio — Inicio">
          Forge<span class="text-accent">Studio</span>
        </a>
        <p class="mt-2 font-sans text-xs text-muted">
          Experiencias digitales que convierten.
        </p>
      </div>

      <nav aria-label="Navegación del footer">
        <ul class="flex flex-wrap justify-center gap-6" role="list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-sm text-muted transition-colors duration-200 hover:text-text focus-visible:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Redes sociales">
        <ul class="flex gap-4" role="list">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="flex size-10 items-center justify-center rounded-full border border-muted/20 font-heading text-xs font-bold text-muted transition-colors duration-200 hover:border-accent hover:text-accent focus-visible:border-accent focus-visible:text-accent"
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.icon}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 border-t border-muted/10 pt-6 text-center">
      <p class="font-sans text-xs text-muted">
        &copy; {new Date().getFullYear()} Forge Studio. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
