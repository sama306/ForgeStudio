---
const links = [
  { label: 'Trabajos', href: '/work' },
  { label: 'Servicios', href: '/services' },
  { label: 'Nosotros', href: '/about' },
  { label: 'Contacto', href: '/contact' },
];

const socials = [
  { label: 'GitHub', href: 'https://github.com/sama306', icon: 'GH' },
  { label: 'Dribbble', href: '#', icon: 'DB' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/dante-valent%C3%ADn-samacoits-2880b8261/', icon: 'LI' },
  { label: 'X / Twitter', href: '#', icon: 'X' },
];
---

<footer class="border-t border-muted/10 bg-bg px-6 py-16" aria-label="Pie de página">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col items-center justify-between gap-10 md:flex-row md:items-start">
      <div class="text-center md:text-left">
        <a href="/" class="flex items-center gap-2.5" aria-label="Forge Studio — Inicio">
          <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
            <path d="M16 1l3 10.5L29.5 14l-10.5 3-3 10.5-3-10.5L2.5 14l10.5-3L16 1Z" fill="#FF6B00"/>
          </svg>
          <span class="font-heading text-xl tracking-tight text-text">Forge<span class="text-accent">Studio</span></span>
        </a>
        <p class="mt-2 font-sans text-xs text-muted">
          Experiencias digitales que convierten.
        </p>
      </div>

      <nav aria-label="Navegación del footer">
        <ul class="flex flex-wrap justify-center gap-6" role="list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-sm text-muted transition-colors duration-200 hover:text-text focus-visible:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Redes sociales">
        <ul class="flex gap-4" role="list">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="flex size-10 items-center justify-center rounded-full border border-muted/20 font-heading text-xs font-bold text-muted transition-colors duration-200 hover:border-accent hover:text-accent focus-visible:border-accent focus-visible:text-accent"
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.icon}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 border-t border-muted/10 pt-6 text-center">
      <p class="font-sans text-xs text-muted">
        &copy; {new Date().getFullYear()} Forge Studio. Todos los derechos reservados.
      </p>
      <nav aria-label="Enlaces legales" class="mt-3">
        <ul class="flex justify-center gap-4 text-xs" role="list">
          <li>
            <a href="/terms" class="font-sans text-muted transition-colors duration-200 hover:text-text focus-visible:text-accent">
              Términos de uso
            </a>
          </li>
          <li>
            <a href="/privacy" class="font-sans text-muted transition-colors duration-200 hover:text-text focus-visible:text-accent">
              Política de privacidad
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
