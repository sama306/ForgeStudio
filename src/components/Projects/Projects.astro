---
import { getCollection } from 'astro:content';
import { ProjectCard } from '../ProjectCard';

const projects = await getCollection('projects');
---

<section class="bg-bg px-6 py-24" aria-label="Featured projects">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-heading font-bold leading-none text-text" style="font-size: var(--text-h1)" data-reveal>
      Featured Projects
    </h2>
    <p class="mt-4 max-w-xl font-sans text-muted" style="font-size: var(--text-body);">
      A selection of recent work that showcases our approach to design, development, and strategy.
    </p>

    <div class="mt-16 grid gap-8 md:grid-cols-2">
      {projects.map((project) => (
        <div class="project-item">
          <ProjectCard {project} />
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .project-image-reveal {
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    transform: scale(1.05);
    will-change: transform, clip-path;
  }
</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { getLenis } from '../../utils/lenis';
import { revealHeadings } from '../../utils/textReveal';
revealHeadings('[data-reveal]');

const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

if (!prefersReduced) {
  gsap.registerPlugin(ScrollTrigger);

  const lenis = getLenis();
  if (lenis) {
    lenis.on('scroll', ScrollTrigger.update);
  }

  gsap.ticker.lagSmoothing(0);

  document.querySelectorAll<HTMLElement>('.project-item').forEach(function (item) {
    const img = item.querySelector<HTMLElement>('.project-image-reveal');
    if (!img) return;

    gsap.fromTo(
      img,
      {
        clipPath: 'polygon(0 100%, 100% 100%, 100% 100%, 0 100%)',
        scale: 1.05,
      },
      {
        clipPath: 'polygon(0 0%, 100% 0%, 100% 100%, 0 100%)',
        scale: 1,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
} else {
  document.querySelectorAll<HTMLElement>('.project-image-reveal').forEach(function (img) {
    img.style.clipPath = 'polygon(0 0%, 100% 0%, 100% 100%, 0 100%)';
    img.style.transform = 'scale(1)';
  });
}
</script>
