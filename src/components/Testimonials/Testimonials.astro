---
const testimonials = [
  {
    quote: 'Forge no solo construyó un producto — redefinió cómo pensamos nuestra presencia digital. La profundidad detrás de cada píxel es extraordinaria.',
    author: 'Sarah Chen',
    role: 'CEO, Lumina Ventures',
  },
  {
    quote: 'Hemos trabajado con varios estudios de diseño, pero ninguno igualó la combinación de precisión técnica y visión creativa de Forge. Nos elevaron el estándar para siempre.',
    author: 'Marcus Rivera',
    role: 'Head of Design, Arcadia',
  },
  {
    quote: 'La atención al detalle fue notable. Forge entregó una plataforma intuitiva, impecable en rendimiento y visualmente impactante — a tiempo y superando expectativas.',
    author: 'Elena Kostova',
    role: 'Product Lead, Nebula Health',
  },
  {
    quote: 'Un estudio poco común que entiende de verdad tanto el oficio como la estrategia. Cada recomendación estaba basada en datos, cada ejecución pulida a la perfección.',
    author: 'David Okonkwo',
    role: 'CTO, Relay Technologies',
  },
];
---

<section class="bg-bg px-6 py-24" aria-label="Testimonios">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-heading font-bold leading-none text-text" style="font-size: var(--text-h1)" data-reveal>
      Lo Que Dicen Nuestros Clientes
    </h2>
    <p class="mt-4 max-w-xl font-sans text-muted" style="font-size: var(--text-body);">
      La opinión de los equipos con los que hemos tenido el privilegio de trabajar.
    </p>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {testimonials.map((t) => (
        <article class="group relative rounded-2xl border border-muted/10 bg-surface p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(0,0,0,0.3)]">
          <div class="mb-6 flex items-start gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-accent/10 text-lg font-bold text-accent" aria-hidden="true">
              {t.author.charAt(0)}
            </div>
            <div>
              <h3 class="font-heading text-sm font-semibold text-text">
                {t.author}
              </h3>
              <p class="font-sans text-xs text-muted">
                {t.role}
              </p>
            </div>
          </div>
          <blockquote class="font-sans leading-relaxed text-muted" style="font-size: var(--text-body);">
            &ldquo;{t.quote}&rdquo;
          </blockquote>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .group {
      transition: none;
    }

    .group:hover {
      transform: none;
    }
  }
</style>

<script>
import { revealHeadings } from '../../utils/textReveal';
revealHeadings('[data-reveal]');
</script>
