---
const links = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-md" aria-label="Main navigation">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="font-heading text-xl tracking-tight text-text" aria-label="Forge Studio — Home">
      Forge<span class="text-accent">Studio</span>
    </a>

    <button
      class="mobile-menu-btn relative z-50 flex size-10 items-center justify-center md:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu-mobile"
      type="button"
    >
      <span class="sr-only">Menu</span>
      <span class="hamburger-line block h-0.5 w-5 rounded bg-text transition-transform duration-200 before:block before:h-0.5 before:w-5 before:rounded before:bg-text before:transition-transform before:duration-200 after:block after:h-0.5 after:w-5 after:rounded after:bg-text after:transition-transform after:duration-200"></span>
    </button>

    <ul id="nav-menu" class="hidden items-center gap-8 md:flex" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium tracking-wide text-muted transition-colors duration-200 hover:text-text focus-visible:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <button
          class="theme-toggle flex size-9 items-center justify-center rounded-full border border-muted/20 text-muted transition-colors duration-200 hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
          aria-label="Toggle theme"
          type="button"
        >
          <svg class="theme-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="theme-sun hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
        </button>
      </li>
    </ul>
  </div>

    <div
    class="mobile-wrapper fixed inset-0 z-40 pointer-events-none overflow-hidden"
    aria-hidden="true"
  >
    <div
      id="nav-menu-mobile"
      class="mobile-panel absolute inset-0 bg-bg px-6 pt-24"
      role="dialog"
      aria-modal="true"
      aria-label="Navigation menu"
    >
      <ul class="flex flex-col gap-6" role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link font-heading text-2xl text-text transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  .mobile-wrapper {
    pointer-events: none;
    overflow: hidden;
  }

  .mobile-wrapper.open {
    pointer-events: auto;
  }

  .mobile-panel {
    visibility: hidden;
    pointer-events: none;
    transform: translateX(100%);
    opacity: 0;
    transition:
      visibility 0s 0.3s,
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .mobile-wrapper.open .mobile-panel {
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    opacity: 1;
    transition:
      visibility 0s 0s,
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-panel {
      transition: none;
    }
  }
</style>

<script>
const menuBtn = document.querySelector('.mobile-menu-btn');
const wrapper = document.querySelector('.mobile-wrapper');
const panel = document.querySelector('#nav-menu-mobile');
const mobileLinks = document.querySelectorAll('.mobile-link');

function openMenu() {
  menuBtn?.setAttribute('aria-expanded', 'true');
  wrapper?.classList.add('open');
  document.body.classList.add('overflow-hidden');
}

function closeMenu() {
  menuBtn?.setAttribute('aria-expanded', 'false');
  wrapper?.classList.remove('open');
  document.body.classList.remove('overflow-hidden');
}

menuBtn?.addEventListener('click', () => {
  const open = menuBtn.getAttribute('aria-expanded') === 'true';
  if (open) closeMenu();
  else openMenu();
});

mobileLinks.forEach((link) => {
  link.addEventListener('click', closeMenu);
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
    closeMenu();
    menuBtn?.focus();
  }
});

// Theme toggle
const themeBtn = document.querySelector('.theme-toggle');
const moon = themeBtn?.querySelector('.theme-moon');
const sun = themeBtn?.querySelector('.theme-sun');

function setTheme(theme) {
  const isLight = theme === 'light';
  document.documentElement.classList.toggle('light', isLight);
  localStorage.setItem('theme', theme);
  moon?.classList.toggle('hidden', isLight);
  sun?.classList.toggle('hidden', !isLight);
  themeBtn?.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
}

function getPreferredTheme() {
  const stored = localStorage.getItem('theme');
  if (stored) return stored;
  return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
}

(function initTheme() {
  const theme = getPreferredTheme();
  const isLight = theme === 'light';
  moon?.classList.toggle('hidden', isLight);
  sun?.classList.toggle('hidden', !isLight);
  themeBtn?.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
})();

themeBtn?.addEventListener('click', () => {
  const isLight = document.documentElement.classList.contains('light');
  setTheme(isLight ? 'dark' : 'light');
});
</script>
