---
export interface Props {
  heading?: string;
  label?: string;
  href?: string;
}

const { heading = "Construyamos\nalgo extraordinario.", label = 'Inicia tu proyecto →', href = '/contact' } = Astro.props;

const lines = heading.split('\n');
---

<section class="cta-section relative flex min-h-screen items-center justify-center overflow-hidden bg-bg" aria-label="Llamado a la acción">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/5 blur-3xl" />
    <div class="absolute -top-40 right-0 h-[400px] w-[400px] rounded-full bg-accent/3 blur-3xl" />
    <div class="absolute -bottom-40 left-0 h-[400px] w-[400px] rounded-full bg-accent/3 blur-3xl" />
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
    {lines.map((line, i) => (
      <p
        class:list={[
          'cta-line font-heading font-bold leading-none tracking-tight text-text',
          i === 0 && 'text-accent',
        ]}
        style="font-size: var(--text-hero);"
        data-reveal
      >
        {line}
      </p>
    ))}
    <a
      href={href}
      class="cta-btn mt-12 inline-flex h-14 items-center justify-center rounded-full bg-accent px-10 text-sm font-semibold tracking-wide text-bg md:h-16 md:px-12 md:text-base"
    >
      {label}
    </a>
  </div>
</section>

<script>
import { revealHeadings } from '../../utils/textReveal';
revealHeadings('[data-reveal]', { stagger: 0.06, yOffset: 30 });

const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

const btn: HTMLElement | null = document.querySelector('.cta-btn');
if (btn && !prefersReduced && !isTouch) {
  btn.addEventListener('mousemove', function (e: MouseEvent) {
    const rect = btn.getBoundingClientRect();
    const x = e.clientX - rect.left - rect.width / 2;
    const y = e.clientY - rect.top - rect.height / 2;
    btn.style.transform = 'translate(' + (x * 0.3) + 'px, ' + (y * 0.3) + 'px) scale(1.04)';
  });

  btn.addEventListener('mouseleave', function () {
    btn.style.removeProperty('transform');
  });
}
</script>

<style>
  .cta-btn {
    transition:
      box-shadow 0.2s ease,
      color 0.2s ease;
    will-change: transform;
  }

  .cta-btn:hover,
  .cta-btn:focus-visible {
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .cta-btn:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn {
      transition: none;
    }
  }
</style>
