---
export interface Props {
  title?: string;
  subtitle?: string;
}
---

  <section
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-bg"
    aria-label="Hero"
  >
  <div class="relative z-10 mx-auto max-w-5xl px-6 text-center">
    <h1
      class="hero-title font-heading font-bold leading-none tracking-tight text-text"
      style="font-size: var(--text-hero);"
    >
      Forge<span class="text-accent">Studio</span>
    </h1>
    <p
      class="hero-subtitle mx-auto mt-6 max-w-2xl font-sans text-muted"
      style="font-size: var(--text-h2);"
    >
      Experiencias digitales que convierten.
    </p>
    <div class="hero-cta-group mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href="/work"
        class="hero-cta hero-cta--primary inline-flex h-12 items-center justify-center rounded-full bg-accent px-8 text-sm font-semibold tracking-wide text-bg"
      >
        Ver Proyectos
      </a>
      <a
        href="/contact"
        class="hero-cta hero-cta--secondary inline-flex h-12 items-center justify-center rounded-full border border-muted/30 px-8 text-sm font-semibold tracking-wide text-text"
      >
        Hablemos
      </a>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 right-0 h-[500px] w-[500px] rounded-full bg-accent/5 blur-3xl" />
    <div class="absolute -bottom-40 left-0 h-[400px] w-[400px] rounded-full bg-accent/3 blur-3xl" />

    <div class="hero-visual-container absolute left-1/2 top-1/2 flex w-[80vmin] max-w-[600px] -translate-x-1/2 -translate-y-1/2 items-center justify-center">
      <svg
        class="size-full"
        viewBox="0 0 400 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <radialGradient id="core-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#FF6B00" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#FF6B00" stop-opacity="0" />
          </radialGradient>
          <filter id="glow-filter">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <g class="hero-pulse" transform="translate(200, 200)">
          <circle r="90" fill="url(#core-glow)" />
          <circle r="6" fill="#FF6B00" opacity="0.6" filter="url(#glow-filter)" />
          <circle r="2" fill="#FF6B00" opacity="0.9" />
        </g>

        <g class="hero-rotate-slow" transform="translate(200, 200)">
          <ellipse cx="0" cy="0" rx="160" ry="50" stroke="#FF6B00" stroke-width="0.5" opacity="0.12" />
          <g class="hero-orbits" transform="rotate(0)">
            <circle cx="160" cy="0" r="2.5" fill="#FF6B00" opacity="0.35" />
            <circle cx="-160" cy="0" r="2" fill="#FF6B00" opacity="0.2" />
            <circle cx="0" cy="50" r="2" fill="#FF6B00" opacity="0.15" />
            <circle cx="0" cy="-50" r="2.5" fill="#FF6B00" opacity="0.3" />
          </g>
        </g>

        <g class="hero-rotate-reverse" transform="translate(200, 200)">
          <ellipse cx="0" cy="0" rx="105" ry="35" stroke="#FF6B00" stroke-width="0.5" opacity="0.15" />
          <g class="hero-orbits-reverse" transform="rotate(45)">
            <circle cx="105" cy="0" r="2" fill="#FF6B00" opacity="0.25" />
            <circle cx="-105" cy="0" r="2" fill="#FF6B00" opacity="0.25" />
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
import gsap from 'gsap';

const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const visualEl = document.querySelector('.hero-visual-container');

if (!prefersReduced) {
  const tl = gsap.timeline();

  tl.fromTo(
    '.hero-title',
    { opacity: 0, filter: 'blur(20px)' },
    { opacity: 1, filter: 'blur(0px)', duration: 0.8, ease: 'power3.out' },
  )
    .fromTo(
      '.hero-subtitle',
      { opacity: 0, filter: 'blur(12px)' },
      { opacity: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power3.out' },
      '-=0.35',
    )
    .fromTo(
      '.hero-cta',
      { opacity: 0, y: 20, filter: 'blur(20px)' },
      { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.5, ease: 'power2.out' },
      '-=0.3',
    );

  if (visualEl) {
    gsap.to(visualEl, {
      y: -16,
      duration: 3,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });
  }

  // Magnetic hover
  document.querySelectorAll<HTMLElement>('.hero-cta').forEach((btn) => {
    btn.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = btn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      btn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px) scale(1.04)`;
    });

    btn.addEventListener('mouseleave', () => {
      btn.style.removeProperty('transform');
    });
  });
}
</script>

<style>
  .hero-title,
  .hero-subtitle,
  .hero-cta {
    opacity: 0;
    filter: blur(20px);
  }

  .hero-cta {
    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
    will-change: transform;
  }

  .hero-cta:hover,
  .hero-cta:focus-visible {
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .hero-cta:focus-visible {
    outline: none;
  }

  .hero-cta--secondary:hover,
  .hero-cta--secondary:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-pulse {
    animation: hero-pulse 4s ease-in-out infinite;
    transform-origin: center;
  }

  .hero-rotate-slow {
    animation: hero-spin 30s linear infinite;
    transform-origin: center;
  }

  .hero-rotate-reverse {
    animation: hero-spin-reverse 20s linear infinite;
    transform-origin: center;
  }

  @keyframes hero-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(0.95); }
  }

  @keyframes hero-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes hero-spin-reverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subtitle,
    .hero-cta {
      opacity: 1;
      filter: blur(0);
    }

    .hero-cta {
      transition: none;
    }

    .hero-pulse,
    .hero-rotate-slow,
    .hero-rotate-reverse {
      animation: none;
    }
  }
</style>
